    "test:local-agent:wire": "node scripts/local-agent-verify.mjs wire",
    "test:isolated": "node scripts/local-agent-verify.mjs all",
    "test:verification-tools": "node --test scripts/local-agent-verify.test.mjs",
    "connector:test": "npm --prefix connector test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",

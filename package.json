{
  "name": "hapark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:db": "tsx scripts/test-db.mts db",
    "test:e2e": "tsx scripts/test-db.mts e2e",
    "postinstall": "prisma generate",
    "test:local-agent": "node scripts/local-agent-verify.mjs unit",

    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "clsx": "^2.1.1",
    "inngest": "^4.5.1",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.4",
    "lucide-react": "^1.18.0",
    "mupdf": "^1.27.0",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.1",
    "tailwind-merge": "^3.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "^4.4.3",

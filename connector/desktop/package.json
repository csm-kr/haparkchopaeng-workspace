{
  "name": "hapark-connector-desktop",
  "productName": "AI 브릿지",
  "stableProfileName": "하박조팽 연결기",
  "version": "0.1.6",
  "private": true,
  "author": "하박조팽",
  "homepage": "https://hapark.vercel.app",
  "description": "웹에서 내 PC의 Codex·Claude Code를 연결하는 데스크톱 앱",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "node ../scripts/start-desktop.mjs",
    "start:dev": "node ../scripts/start-desktop.mjs --connector-dev --no-auto-open",
    "configure": "node ../scripts/configure-desktop.mjs",
    "package:win": "npm run configure && electron-builder --win nsis --x64",
    "package:mac": "npm run configure && node ../scripts/mac-builder.test.mjs && electron-builder --config mac-builder.cjs --mac dmg --arm64 --x64",
    "package:linux": "npm run configure && electron-builder --linux deb --x64",
    "package:dir": "npm run configure && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.hapark.connector",
    "artifactName": "hapark-connector-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "../dist" },
    "files": ["main.mjs", "tray.mjs", "preload.cjs", "renderer/**", "assets/**", "apps.generated.json", "package.json"],
    "extraResources": [{ "from": "../core", "to": "core", "filter": ["**/*.mjs"] }],
    "protocols": [{ "name": "AI 브릿지", "schemes": ["hapark-connect"] }],
    "asar": true,
    "win": { "target": ["nsis"], "icon": "assets/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true, "deleteAppDataOnUninstall": false, "shortcutName": "AI 브릿지", "include": "installer.nsh" },
    "mac": { "target": ["dmg"], "executableName": "hapark-connector", "icon": "assets/icon.png", "category": "public.app-category.productivity", "hardenedRuntime": true, "gatekeeperAssess": false },
    "linux": { "target": ["deb"], "maintainer": "Hapark maintainers", "icon": "assets/icon.png", "category": "Utility", "mimeTypes": ["x-scheme-handler/hapark-connect"], "desktop": { "entry": { "Name": "AI 브릿지", "Comment": "웹과 내 PC의 AI 연결", "Terminal": "false" } } },
    "publish": null
  }
}

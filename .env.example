# ============================================
# 하박조팽 — 환경 변수 예시
# 실제 값은 .env 에 넣는다 (.env 는 커밋 금지, .gitignore 처리됨)
# 자세한 설명: docs/dev/ENV.md
# ============================================

# --- 논문 분석 파이프라인 (LLM = Google Gemini) ---------------
# PDF → 두 관점(연구/재구현) 구조화 분석 + Figure 해석에 Google Gemini를 사용한다 (ADR-011).
# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 분석에 사용할 모델 (기본: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro
# 분석은 요청 경로가 아니라 Inngest 잡으로 실행 (ADR-013→016, jobs-analysis step).
# 로컬은 Inngest Dev Server(키 불필요)로 동작. 아래 키는 프로덕션(클라우드)용.
INNGEST_EVENT_KEY=xxxxxxxx
INNGEST_SIGNING_KEY=signkey-xxxxxxxx

# --- 데이터베이스 (Prisma) -----------------------------------
# 개발: 로컬 SQLite 파일. 운영: Supabase Postgres로 교체 (ADR-010/016).
DATABASE_URL="file:./dev.db"
# 운영(Supabase Postgres) 예시 — 사용 시 위 줄 대신:
# DATABASE_URL="postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://...@...supabase.com:5432/postgres"   # 마이그레이션용 직결

# --- Supabase (Auth + Storage + Realtime) --------------------
# Supabase 프로젝트 대시보드 > Settings > API 에서 발급
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # 공개 anon 키(클라이언트 노출 OK)
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # 비밀! 서버 전용 — 절대 클라이언트 노출 금지

# --- 인증 (Google OAuth via Supabase Auth) -------------------
# Google Cloud Console에서 OAuth 클라이언트(Client ID/Secret)를 만들고,
# 값은 앱이 아니라 Supabase 대시보드 Auth > Providers > Google 에 입력한다.
# 리디렉트 URL은 Supabase가 제공(https://<ref>.supabase.co/auth/v1/callback).
# 세션/초대 토큰 서명용 시크릿(자체) — openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
INVITE_TOKEN_SECRET=change-me-too
APP_BASE_URL=http://localhost:3000

# --- 파일 스토리지 (Supabase Storage; PDF · 에셋 · figure) -----
# 비공개 버킷 + 서명 URL. (Supabase Storage 사용 시 별도 S3 키 불필요 —
# SUPABASE_SERVICE_ROLE_KEY로 서버에서 업로드/서명)
SUPABASE_STORAGE_BUCKET=hapark

# --- 라이브 세미나 (Cloudflare Stream Live) -------------------
# 앱은 Live Input 생성·권한 체크·플레이어 노출만 담당 (ADR-002)
CLOUDFLARE_ACCOUNT_ID=xxxxxxxx
CLOUDFLARE_STREAM_API_TOKEN=xxxxxxxx
# 녹화 완료 등 Stream Live 웹훅 HMAC 검증용 시크릿 (세션 인증 아님 → 서명 검증, SEQUENCE S4.6)
CLOUDFLARE_WEBHOOK_SECRET=xxxxxxxx

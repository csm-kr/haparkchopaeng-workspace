# ============================================
# 하박조팽 — 환경 변수 예시
# 실제 값은 .env 에 넣는다 (.env 는 커밋 금지, .gitignore 처리됨)
# 자세한 설명: docs/dev/ENV.md
# ============================================

# --- 논문 분석 파이프라인 (LLM) -------------------------------
# PDF → 두 관점(연구/재구현) 구조화 분석 + Figure 해석에 Claude API를 사용한다.
# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 분석에 사용할 모델 (기본: 최신 Opus)
ANALYSIS_MODEL=claude-opus-4-8

# --- 데이터베이스 (Prisma + SQLite) --------------------------
# 개발 기본값: 로컬 SQLite 파일. 운영 이전 시 Postgres URL로 교체.
DATABASE_URL="file:./dev.db"

# --- 인증 / 세션 ----------------------------------------------
# 세션 서명용 시크릿 (openssl rand -base64 32 등으로 생성)
AUTH_SECRET=change-me-to-a-long-random-string
# 초대 링크 토큰 서명용 시크릿
INVITE_TOKEN_SECRET=change-me-too
# 앱 베이스 URL (초대 링크 생성에 사용)
APP_BASE_URL=http://localhost:3000

# --- 파일 스토리지 (원문 PDF · 발표 에셋 · figure 이미지) ------
# S3 호환 스토리지 (R2/S3/MinIO 등). 다운로드는 서명 URL로만 제공.
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_BUCKET=hapark
STORAGE_ACCESS_KEY_ID=xxxxxxxx
STORAGE_SECRET_ACCESS_KEY=xxxxxxxx

# --- 라이브 세미나 (Cloudflare Stream Live) -------------------
# 앱은 Live Input 생성·권한 체크·플레이어 노출만 담당 (ADR-002)
CLOUDFLARE_ACCOUNT_ID=xxxxxxxx
CLOUDFLARE_STREAM_API_TOKEN=xxxxxxxx
